{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_STOP_REVIEW": "0",
    "SECURITY_REVIEW_MODEL": "claude-sonnet-5",
    "SG_AGENTIC_MODEL": "claude-sonnet-5"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/handoffs/bin/jarvis hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/handoffs/bin/jarvis hook pretool",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/handoffs/bin/jarvis statusline"
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "supabase@supabase-community-supabase-plugin": false,
    "vercel@claude-plugins-official": false,
    "convex@claude-plugins-official": false,
    "neon-postgres@neon": false,
    "hyperframes@claude-plugins-official": false,
    "browser-use@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  }
}
